// CREACIÓN DE COLECCIONES E ÍNDICES


// Creación explícita de colecciones
db.createCollection("pacientes");
db.createCollection("hospitales_infraestructura");
db.createCollection("alertas_transacciones");

// Índices para la colección PACIENTES
// Permite filtrar por especialidad, ordenar por urgencia y hacer búsquedas geoespaciales rápidamente
db.pacientes.createIndex({ 
  "ubicacion": "2dsphere", 
  "especialidad_requerida": 1, 
  "nivel_urgencia": -1 
});

// Índices para la colección HOSPITALES
db.hospitales_infraestructura.createIndex({ 
  "coordenadas": "2dsphere", 
  "quirofanos.especialidad_asignada": 1 
});

// Índices para ALERTAS Y TRANSACCIONES
db.alertas_transacciones.createIndex({ 
  "estado_proceso": 1, 
  "fecha_alerta": -1 
});



